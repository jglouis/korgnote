    <string name="notes_onboarding_choose_another">Choose another</string>
    <string name="notes_onboarding_no_folder">Notes cannot be kept in a folder on this device.</string>
    <string name="notes_onboarding_server_heading">Connect to your computer</string>
    <string name="notes_onboarding_server_step1">On the computer with your notes, start the KorgNote server.</string>
    <string name="notes_onboarding_install_server">How to install the server</string>
    <string name="notes_onboarding_server_step2">There, open %1$s and press Show a pairing code.</string>
    <string name="notes_onboarding_server_step3">Scan the code with this device, or paste the link shown under it.</string>
    <string name="notes_onboarding_local_network_computer">Your computer is on your local network. Android asks before an app may reach it.</string>
    <string name="notes_onboarding_allow_local_network">Allow local network</string>
    <string name="notes_onboarding_continue">Continue</string>
    <string name="notes_onboarding_pair_later">Pair later</string>
    <string name="notes_onboarding_unpaired">Without pairing, KorgNote starts empty and syncs once you pair in Settings.</string>
    <string name="notes_onboarding_webdav_heading">Connect to a WebDAV server</string>
    <string name="notes_onboarding_webdav_intro">Experimental. KorgNote keeps its own copy of the notes and syncs it with a folder on the server, as it does with the KorgNote server.</string>
    <string name="notes_onboarding_folder_address">Folder address</string>
    <string name="notes_onboarding_nextcloud_address">On Nextcloud, it is under Files settings, WebDAV, with the notes folder's name added.</string>
    <string name="notes_onboarding_user_name">User name</string>
    <string name="notes_onboarding_password">Password</string>
    <string name="notes_onboarding_app_password">Nextcloud and most hosting services give an app password for this, apart from your own.</string>
    <string name="notes_onboarding_local_network_server">If the server is on your local network, Android asks before an app may reach it.</string>
    <string name="notes_onboarding_https_needed">The address must start with https://, or the password would cross the network as it is.</string>
    <string name="notes_onboarding_checking_server">Checking the server…</string>
    <string name="notes_onboarding_server_empty">The server can be used. No notes there yet: new notes will go there.</string>
    <plurals name="notes_onboarding_server_count">
        <item quantity="one">The server can be used. %1$d note there.</item>
        <item quantity="other">The server can be used. %1$d notes there.</item>
    </plurals>
    <string name="notes_onboarding_server_unusable">KorgNote cannot use this server. %1$s</string>
    <string name="notes_onboarding_use_server">Use this server</string>
    <string name="notes_onboarding_check_server">Check the server</string>
    <string name="notes_onboarding_check_explained">The check writes a hidden file, .korgnote-check, and deletes it again. It makes sure the server refuses a write over a newer version, which is what keeps one device from overwriting another's edits.</string>
    <string name="notes_onboarding_reminders">Reminders</string>
    <string name="notes_onboarding_reminders_intro">KorgNote can remind you before timed entries, and sum up your day each morning. For that it needs to show notifications.</string>
    <string name="notes_onboarding_allow_notifications">Allow notifications</string>
    <string name="notes_onboarding_not_now">Not now</string>
    <string name="notes_onboarding_reminders_later">You can turn them on or off later, in Settings and in the system's settings.</string>

