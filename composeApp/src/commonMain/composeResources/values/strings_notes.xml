<resources>
    <!-- Onboarding -->
    <string name="notes_onboarding_where">Where are your notes?</string>
    <string name="notes_onboarding_welcome">Welcome to KorgNote</string>
    <string name="notes_onboarding_intro">Your notes stay plain Org files. Where should KorgNote find them?</string>
    <string name="notes_onboarding_folder_title">A folder on this device</string>
    <string name="notes_onboarding_folder_pro">Nothing else to install.</string>
    <string name="notes_onboarding_folder_con">Syncing is up to that app. A note edited on two devices at once ends up as a conflict copy.</string>
    <string name="notes_onboarding_server_title">My computer, with the KorgNote server</string>
    <string name="notes_onboarding_server_pro">Syncs straight with your computer: no cloud, no other app.</string>
    <string name="notes_onboarding_merged">A note edited on both sides is merged.</string>
    <string name="notes_onboarding_server_con">The server runs on that computer, and this device must reach it: same Wi-Fi, or a VPN.</string>
    <string name="notes_onboarding_webdav_title">A WebDAV server (experimental)</string>
    <string name="notes_onboarding_webdav_pro">Nextcloud, a NAS or a hosting service you already have, so no computer needs to stay on.</string>
    <string name="notes_onboarding_webdav_con">New, and tried with Nextcloud and Apache only. Over HTTPS, and only with a server that passes a safety check.</string>
    <string name="notes_onboarding_all_offline">All of them work offline. You can change this later in Settings.</string>
    <string name="notes_onboarding_both_offline">Both work offline. You can change this later in Settings.</string>
    <string name="notes_onboarding_for">For</string>
    <string name="notes_onboarding_against">Against</string>
