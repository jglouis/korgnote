<?xml version="1.0" encoding="utf-8"?>
<!-- The agenda widget in the widget picker, on Android 12 to 14: a still picture of it, made-up entries and all.
     From 15 the widget draws its own preview (WidgetPreviews). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_card"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_agenda_title"
            android:textColor="@color/widget_preview_text"
            android:textSize="16sp"
            android:textStyle="bold" />
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_widget_sync"
            android:tint="@color/widget_preview_muted" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/widget_preview_status"
        android:textColor="@color/widget_preview_muted"
        android:textSize="11sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp"
        android:text="@string/widget_today"
        android:textColor="@color/widget_preview_accent"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="3dp">

        <View
            android:layout_width="3dp"
            android:layout_height="30dp"
            android:layout_marginEnd="8dp"
            android:background="@color/widget_preview_error" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_preview_keyword_1"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:text="TODO"
            android:textColor="@color/widget_preview_keyword_1"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="@string/widget_preview_entry_1"
            android:textColor="@color/widget_preview_text"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="3dp">

        <View
            android:layout_width="3dp"
            android:layout_height="30dp"
            android:layout_marginEnd="8dp"
            android:background="@color/widget_preview_tertiary" />
        <TextView
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:text="10:00–11:00"
            android:textColor="@color/widget_preview_text"
            android:textSize="12sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="@string/widget_preview_entry_2"
            android:textColor="@color/widget_preview_text"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp"
        android:text="@string/widget_tomorrow"
        android:textColor="@color/widget_preview_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="3dp">

        <View
            android:layout_width="3dp"
            android:layout_height="30dp"
            android:layout_marginEnd="8dp"
            android:background="@color/widget_preview_accent" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_preview_keyword_2"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:text="NEXT"
            android:textColor="@color/widget_preview_keyword_2"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="@string/widget_preview_entry_4"
            android:textColor="@color/widget_preview_text"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="3dp">

        <View
            android:layout_width="3dp"
            android:layout_height="30dp"
            android:layout_marginEnd="8dp"
            android:background="@color/widget_preview_tertiary" />
        <TextView
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:text="14:30"
            android:textColor="@color/widget_preview_text"
            android:textSize="12sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="@string/widget_preview_entry_3"
            android:textColor="@color/widget_preview_text"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
