<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the share extension: the queue of captures waiting to be filed. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.korgnote.korgnote.korgnote$(TEAM_ID)</string>
	</array>
</dict>
</plist>
