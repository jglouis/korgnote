# Keep the build context to what the Dockerfile copies: the web client's Gradle build and the server.
.git
.gradle
.kotlin
.idea
**/build/
build/
notes/
iosApp/
docs/
fastlane/
scripts/
.github/
README.md
LICENSE
Dockerfile
docker-compose.yml
# Holds the host's Android SDK path, which means nothing inside the image.
local.properties
*.iml
.DS_Store
# Holds this computer's settings for docker compose, which mean nothing inside the image either.
.env
# The server's build output, which the Dockerfile builds again inside the image.
server/target/
# Worktrees and scratch files of coding sessions: whole copies of the repository.
.claude/
