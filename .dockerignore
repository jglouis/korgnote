# Keep the build context to what the Dockerfile's Gradle tasks need to configure and compile: its
# `COPY . .` runs them again whenever anything copied changes.
.git
.gradle
.kotlin
.idea
**/build/
build/
notes/
iosApp/
docs/
fastlane/
scripts/
.github/
README.md
LICENSE
Dockerfile
docker-compose.yml
# Holds the host's Android SDK path, which means nothing inside the image.
local.properties
*.iml
.DS_Store
# Holds this computer's settings for docker compose, which mean nothing inside the image either.
.env
